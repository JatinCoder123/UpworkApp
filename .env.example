# ==============================================================================
# SuiteCRM & Smart Gateway Configuration
# ==============================================================================
# Base URL of the SuiteCRM instance
VITE_CRM_BASE_URL=https://upwork.outrightcrm.in

# Specific CRM entrypoints (defaults auto-derive from VITE_CRM_BASE_URL)
VITE_SMART_GATEWAY_URL=https://upwork.outrightcrm.in/index.php?entryPoint=smart_gateway
VITE_TECH_CONTENT_DOCX_URL=https://upwork.outrightcrm.in/index.php?entryPoint=TechContentDocx
VITE_DOWNLOAD_URL=https://upwork.outrightcrm.in/index.php?entryPoint=download
VITE_VIEW_DOC_URL=https://upwork.outrightcrm.in/index.php?entryPoint=viewdoc

# ==============================================================================
# Backend Services & WebSocket
# ==============================================================================
# Auth & Domain Intelligence backend URL (required: login, session and domain API)
VITE_AUTH_BASE_URL=https://feedappbackend.outrightcrm.in
VITE_BACKEND_URL=https://feedappbackend.outrightcrm.in

# Real-time Document Status WebSocket server
VITE_DOC_SOCKET_URL=https://feedappbackend.outrightcrm.in

# ==============================================================================
# SuiteCRM Module Names
# ==============================================================================
VITE_JOBS_MODULE=outr_upwork_jobs
VITE_TECH_NEWS_MODULE=daily_tech_news
VITE_SITE_CONTENT_MODULE=sites_tech_content
VITE_VIDEO_FEEDS_MODULE=video_feeds
VITE_SKILLS_MODULE=outr_skills
VITE_JOB_ACTIVITY_MODULE=outr_job_activity
VITE_USERS_MODULE=Users
VITE_TECH_NEWS_PER_PAGE=10

# CRM field that holds a skill's category
VITE_SKILL_CATEGORY_FIELD=category

# ==============================================================================
# Cover Letter & AI Action Endpoints
# ==============================================================================
# Ask AI and the cover letter AI editor use VITE_AUTH_BASE_URL (/api/ai/ask, /api/ai/cover-letter).
VITE_COVER_LETTER_URL=
VITE_STRATEGY_URL=

# ==============================================================================
# Site Content
# ==============================================================================
# WordPress login where a ready document is published
VITE_PUBLISH_SITE_URL=https://sites.outrightcrm.in/wp-login.php?4dx-one
