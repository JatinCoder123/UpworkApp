# Optional override for the Microsoft authentication backend.
# Production defaults to https://upworkapp.backend.outrightcrm.in
# Development defaults to http://localhost:3002
VITE_AUTH_BASE_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Domain Intelligence (/domain) — used by src/services/domainApi.js
# WARNING: every VITE_* value is compiled into the public JavaScript bundle,
# so anyone who opens the site can read these keys. Use restricted keys and
# rotate them if they leak.
# ---------------------------------------------------------------------------

# GoDaddy v3 availability API (Personal Access Token). GoDaddy blocks direct
# browser calls (no CORS), so requests go through the /proxy/godaddy path that
# vite.config.js forwards. In production, point this at an equivalent rewrite.
VITE_GODADDY_PAT=
VITE_GODADDY_API_BASE=/proxy/godaddy

# NameSilo price comparison (also needs the proxy: its CORS headers are invalid).
VITE_NAMESILO_API_KEY=
VITE_NAMESILO_API_BASE=/proxy/namesilo

# Azure AI Foundry / Azure OpenAI Responses API (CORS-enabled, called directly).
VITE_FOUNDRY_RESPONSES_URL=https://ashis-mcud14tl-eastus2.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
VITE_FOUNDRY_API_KEY=
VITE_FOUNDRY_MODEL=gpt-5.5

# Moz Links API v2 (needs the proxy: no CORS headers).
VITE_MOZ_ACCESS_ID=
VITE_MOZ_SECRET_KEY=
VITE_MOZ_API_BASE=/proxy/moz

# CRM smart_gateway that stores domain searches, results and favorites.
VITE_DOMAIN_CRM_GATEWAY_URL=https://crm.outrightsystems.org/index.php?entryPoint=smart_gateway
VITE_DOMAIN_CRM_GATEWAY_SECRET=
