# Optional override for the Microsoft authentication backend.
# Production defaults to https://upworkapp.backend.outrightcrm.in
# Development defaults to http://localhost:3002
VITE_AUTH_BASE_URL=http://localhost:3002

# Domain Intelligence (/domain) calls the backend at /api/domain/*. Provider keys
# (GoDaddy, NameSilo, Moz, Azure AI Foundry, CRM) live in the backend .env only.

# Endpoint the job detail "Fetch cover letter" button posts to. It receives the job
# (id, job_id, title, description, skills, upwork_url) and should return
# { cover_letter: "..." } (plain text or base64).
VITE_COVER_LETTER_URL=
